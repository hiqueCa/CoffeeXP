{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "prConcurrentLimit": 5,
      "prHourlyLimit": 0,
      "minimimReleaseAge": "14 days"
    }
  ]
}
