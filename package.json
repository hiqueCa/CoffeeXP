{
  "name": "@coffeeExp/root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @coffeeExp/app dev",
    "db:studio": "pnpm --filter @coffeeExp/db studio",
    "db:up": "pnpm --filter @coffeeExp/db up",
    "db:down": "pnpm --filter @coffeeExp/db down",
    "test": "vitest",
    "test:watch": "pnpm --parallel test:watch",
    "lint": "pnpm lint",
    "typecheck": "pnpm typecheck",
    "format": "pnpm format"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
