{
  "name": "@coffeeExp/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "dprint fmt",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "db:down": "docker compose down -v",
    "db:up": "docker compose up -d",
    "db:studio": "drizzle-kit studio",
    "migrations:push": "drizzle-kit push",
    "migrations:generate": "drizzle-kit generate",
    "migrations:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "catalog:db",
    "pg": "catalog:db",
    "@coffeeExp/env": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "catalog:db",
    "drizzle-kit": "catalog:db"
  }
}
